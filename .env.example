# Optional — enables dynamic hero/thumbnail imagery from stock APIs
VITE_UNSPLASH_ACCESS_KEY=
VITE_PEXELS_API_KEY=
# Canonical site URL for SEO (defaults to https://referrals.live)
VITE_SITE_URL=https://referrals.live
# Owner attribution values applied to every referral URL
VITE_OWNER_REF_CODE=
VITE_OWNER_EMAIL=
VITE_OWNER_ID=
VITE_OWNER_PHONE=

# Premium checkout fallbacks — paste these so payments work with zero backend setup.
# Create a Stripe Payment Link (Stripe Dashboard → Payment links) for the $7.99/mo plan
# and a PayPal button/link. Logged-in users still use the tracked /api/billing/checkout
# flow first; these are used as the fallback (and for logged-out visitors).
VITE_STRIPE_PAYMENT_LINK=
VITE_PAYPAL_LINK=

# AdSense ad unit slot IDs (create units in AdSense, then paste the numeric slot IDs).
# Until set, ad regions stay hidden — keeps the layout clean for AdSense review.
VITE_ADSENSE_SLOT_BANNER=
VITE_ADSENSE_SLOT_RECT=
VITE_ADSENSE_SLOT_MOBILE=
VITE_ADSENSE_SLOT_FEED=
